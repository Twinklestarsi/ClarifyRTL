# Ignore files by default, then allow source code.
*
!*/
!.gitignore
!*.py
!*.pyi
!*.v
!*.vh
!*.sv
!*.svh
!*.c
!*.h
!*.cc
!*.cpp
!*.hpp
!*.sh
!*.tcl

# Local settings, credentials, caches, and experiment outputs.
.agents/
.aws/
.codex/
.env
.env.*
__pycache__/
.pytest_cache/
.mypy_cache/
.venv/
venv/
logs/
/DAG/experiment/llm_generation_errors/
/experiments/data/group1/
/experiments/data/group2/
/experiments/fuzz/out/
/experiments/runner_cases/
